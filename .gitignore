# ==========================
# 1. 그누보드(GnuBoard) 필수 제외
# ==========================
# 핵심: 업로드 파일, 세션, 캐시, DB설정 파일이 들어있는 폴더
/data/*

# 단, data 폴더 내의 .htaccess 파일은 필요할 수 있으므로 예외 처리 (선택)
# !/data/.htaccess

# 설정 파일 (보안 정보가 포함될 수 있음)
/config.php
/dbconfig.php

# 설치 폴더 (설치 완료 후에는 불필요하거나 보안상 제외)
/install/

# 썸네일 및 임시 파일
*_thumb
*.bak
*.old

# ==========================
# 2. 패키지 및 라이브러리 (Composer/NPM)
# ==========================
/node_modules
/vendor
/composer.lock
package-lock.json

# ==========================
# 3. 운영체제 및 에디터 (OS & IDE)
# ==========================
# Windows / Mac 시스템 파일
Thumbs.db
Desktop.ini
.DS_Store

# VS Code / IntelliJ 등 에디터 설정
.idea
.vscode
*.suo
*.ntvs
*.njsproj
*.sln
*.swp
*.log

# ==========================
# 4. 보안 및 기타
# ==========================
.env
.env.backup
*.sql
*.zip
*.tar.gz
*.rar
**/backup/
repomix-output.xml
vendor.tar
